# Copia este archivo a .env solo como recordatorio local.
# La aplicación no lee .env por sí misma: exporta las variables en el entorno.
# El perfil "dev" tiene valores locales propios. El perfil "prod" exige estas variables
# y rechaza los secretos de desarrollo.

# Secreto HMAC de los JWT de acceso. Mínimo 32 caracteres. Distinto en cada entorno.
NEIVER_JWT_SECRET=

# Conexión de la aplicación. Este rol no puede ser superusuario ni tener BYPASSRLS.
NEIVER_DB_URL=jdbc:postgresql://localhost:5432/neiver
NEIVER_DB_USER=neiver_app
NEIVER_DB_PASSWORD=

# Conexión de Flyway. Es la propietaria de las tablas y no debe usarse en la API.
NEIVER_DB_MIGRATOR_USER=neiver_migrator
NEIVER_DB_MIGRATOR_PASSWORD=

# Primer SUPER_ADMIN. Solo se crea si todavía no existe ninguno.
# No se restablece la contraseña en arranques posteriores.
NEIVER_SUPERADMIN_EMAIL=
NEIVER_SUPERADMIN_PASSWORD=
NEIVER_SUPERADMIN_NAME=Administrador Neiver

# Origen permitido del navegador. Con cookies de sesión hace falta el origen exacto.
NEIVER_CORS_ALLOWED_ORIGINS=http://localhost:4200

# true cuando el sitio se sirve por HTTPS.
NEIVER_COOKIE_SECURE=false

# OpenAI (fase 2). Vacío = no hay completions; el límite de presupuesto sí se aplica.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEIVER_USD_TO_EUR=0.92

# WhatsApp Cloud API (hostelería). Vacío = avisos no disponibles (503).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
